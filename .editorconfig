# The Kotlin style surface ktlint enforces (CI runs ktlintCheck).
# "official" matches kotlin.code.style=official in gradle.properties.
# dprint owns JSON/YAML/Markdown/Dockerfile; this file's [*.kt]/
# [*.kts] sections are ktlint's to read.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{kt,kts}]
# "official" is not a valid ktlint code style — the valid value is
# "ktlint_official" (an invalid value logged a warning per file and
# silently fell back to the default, which happens to be the same
# style; pinned explicitly so the warning never returns).
ktlint_code_style = ktlint_official
max_line_length = 120
