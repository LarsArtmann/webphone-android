<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight base: the dialer and settings follow the system.
         Edge-to-edge: transparent system bars; each surface pads its
         own content with window insets. -->
    <style name="Theme.WebPhone" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="wpBackground">@color/wp_background</item>
        <item name="wpSurface">@color/wp_surface</item>
        <item name="wpSurfaceRaised">@color/wp_surface_raised</item>
        <item name="wpOnSurface">@color/wp_on_surface</item>
        <item name="wpOnSurfaceMuted">@color/wp_on_surface_muted</item>
        <item name="wpOutline">@color/wp_outline</item>
        <item name="wpAccent">@color/wp_accent</item>
        <item name="wpOnAccent">@color/wp_on_accent</item>
        <item name="wpAccentSubtle">@color/wp_accent_subtle</item>
        <item name="wpStatusOn">@color/wp_status_on</item>
        <item name="wpStatusPending">@color/wp_status_pending</item>
        <item name="wpDanger">@color/wp_danger</item>
        <item name="wpOnDanger">@color/wp_on_danger</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/wp_background</item>
    </style>

    <!-- The in-call surface is always dark: same tokens, dark fixed
         background, light system-bar glyphs. -->
    <style name="Theme.WebPhone.Call">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/call_bg_bottom</item>
    </style>
</resources>
