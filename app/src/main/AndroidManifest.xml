<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The ntfy lane's #1 missed-ring cause is OEM battery managers
         killing the dataSync socket; the in-context exemption dialog
         needs this declaration (sideload lane — no Play policy). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.WebPhone"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!-- uiMode is deliberately NOT in configChanges on any
             surface: a day/night switch must recreate the activity so
             the programmatically built views re-resolve every wp*
             token from the fresh theme (the stale-colors defect,
             fixed 2026-10-25). -->
        <activity
            android:name=".shell.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The deep-link intake (VIEW links routed by routeDeepLink).
                 The https filter's host is PAIRED with App.DEFAULT_ORIGIN
                 ("pbx.artmann.tech") — change both or neither. autoVerify
                 needs /.well-known/assetlinks.json served BY the stack
                 (webphone repo); unverified, links still open via the
                 chooser. A wildcard host here would spam the chooser for
                 every https link on the device — never. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pbx.artmann.tech" />
            </intent-filter>
            <!-- The dialable protocols: a SIP phone answers its own
                 tel:/sip: links (chooser entry; the system dialer keeps
                 its role until the user prefers this app). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
                <data android:scheme="callto" />
                <data android:scheme="sip" />
            </intent-filter>
        </activity>

        <!-- The in-call surface: CallStyle notifications and the
             full-screen incoming-call intent land here. -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.WebPhone.Call"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- The dialer entry: number in, mic permission, dial. The
             configChanges set preserves the typed number across
             rotation (house pattern, same as the other surfaces). -->
        <activity
            android:name=".call.DialpadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Settings: the stack origin (the one fact the app cannot
             guess) lives here. -->
        <activity
            android:name=".shell.SettingsActivity"
            android:exported="false" />

        <!-- Self-managed Telecom integration: the app owns its call UI,
             the OS gets call-state integration (BT/watches, audio
             focus, Do Not Disturb) through the ConnectionService. -->
        <service
            android:name=".call.CallConnectionService"
            android:exported="false"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- The call's foreground service: typed microphone+phoneCall,
             started only from user interaction (the push → full-screen
             intent → answer flow is the legitimate launch path; a mic
             FGS cannot start from the background). -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <!-- The shade's call actions (CallStyle Answer/Decline, the
             ongoing call's Hang up): explicit intents only. -->
        <receiver
            android:name=".call.CallNotificationReceiver"
            android:exported="false" />

        <!-- The ntfy lane's subscription socket: a low-cost dataSync
             FGS holding the websocket to the self-hosted ntfy server
             (the de-Googled device's push transport). -->
        <service
            android:name=".push.NtfySubscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The FCM lane: Google Play services delivers; no service of
             our own runs (the receiver wakes the RingRouter). -->
        <service
            android:name=".push.FcmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- No google-services plugin by default: a GMS build drops in
             google-services.json and enables the plugin. The ntfy lane
             works without any Google dependency. -->
    </application>
</manifest>
